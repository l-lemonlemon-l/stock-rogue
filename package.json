{
  "name": "stock-rogue",
  "version": "1.0.0",
  "description": "Roguelike stock trading game with online multiplayer",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal",
    "build:web": "node tools/build-web.js web",
    "build:android": "node tools/build-web.js android && npx cap sync android"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "steamworks.js": "^0.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@fontsource/pixelify-sans": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.10",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3"
  },
  "productName": "Stock Rogue",
  "build": {
    "appId": "com.lemonlemon.stockrogue",
    "productName": "Stock Rogue",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "server/**",
      "shared/**",
      "public/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "x64ArchFiles": "**/steamworks.js/dist/osx/*",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Stock Rogue uses the microphone for voice chat with other players in your room."
      }
    }
  }
}